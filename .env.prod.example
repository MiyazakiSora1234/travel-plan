# 本番EC2の /opt/travel-plan/.env に配置するファイルの例。
# このファイル自体はドキュメント用であり、GitHub Actionsからは一切参照・上書きされない。
# 実際の値はEC2上で一度だけ手動で設定し、以後Gitでは管理しない。

POSTGRES_DB=travel_plan
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-password

APP_DB_USER=travel_plan_app
APP_DB_PASSWORD=change-me-app-password

DATABASE_URL=jdbc:postgresql://postgres:5432/travel_plan

# 本番フロントエンドのオリジンに合わせて設定する（ワイルドカード禁止）
CORS_ALLOWED_ORIGINS=http://<EC2_HOST_OR_DOMAIN>

SERVER_PORT=8080

# IMAGE_TAG は .env に書かず、deploy.yml が `export IMAGE_TAG=<git sha>` として
# docker compose 実行時に渡す。手動でdocker composeを叩く場合のみ、ここか
# シェルで指定すること。
