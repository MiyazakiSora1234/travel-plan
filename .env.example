# PostgreSQL bootstrap superuser. Used only by the container's initdb
# process and to create the restricted application role below — the
# application itself never connects with this account.
POSTGRES_DB=travel_plan
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-password
# Host-side port mapping for local psql access. Change if 5432 is already in use.
POSTGRES_HOST_PORT=5432

# Restricted role used by Flyway migrations and the Spring Boot application.
# No SUPERUSER/CREATEDB/CREATEROLE privileges (see docker/postgres/initdb).
APP_DB_USER=travel_plan_app
APP_DB_PASSWORD=change-me-app-password

# Backend
DATABASE_URL=jdbc:postgresql://postgres:5432/travel_plan
CORS_ALLOWED_ORIGINS=http://localhost:5173
SERVER_PORT=8080

# Frontend (baked into the client bundle by Vite; must point to a URL
# reachable from the browser, not the Docker-internal service name)
VITE_API_BASE_URL=http://localhost:8080
